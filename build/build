#!/bin/bash -e

SLUG="novamira"
BASEDIR=$(dirname $(dirname $(realpath "$0")))
BUILD_BASE=$(mktemp -d /tmp/ooo-build-XXXXXX)
BUILD_DIR="$BUILD_BASE/$SLUG"

if [ $# -ne 1 ]; then
	echo "usage: $0 version"
	exit 1
fi

VERSION="$1"

mkdir -p "$BUILD_DIR"
cd "$BASEDIR"

# Build the Novamira Chat dashboard assets (src/chat -> includes/assets/chat)
rm -rf includes/assets/chat
rm -rf node_modules
bun install --frozen-lockfile
bun run build

# Build Novamira Visual assets when present
if [ -d novamira-visual ]; then
	cd novamira-visual
	rm -rf dist
	rm -rf node_modules
	bun install --frozen-lockfile
	bun run build
	cd "$BASEDIR"
fi

GIT_LS_FILES=$(mktemp)
git ls-files >"$GIT_LS_FILES"
rsync -rl --files-from="$GIT_LS_FILES" --exclude-from=build/build-ignore ./ "$BUILD_DIR/"
rm "$GIT_LS_FILES"

# Novamira Chat compiled assets are gitignored, so copy them in explicitly
rsync -rl --mkpath includes/assets/chat/ "$BUILD_DIR/includes/assets/chat/"

# Novamira Visual compiled assets when present
if [ -d novamira-visual/dist ]; then
	rsync -rl --mkpath --include='*.js' --exclude='*' novamira-visual/dist/ "$BUILD_DIR/novamira-visual/dist/"
fi

# Install production dependencies directly into the isolated build. This keeps
# the zip independent of the existing ignored vendor tree and leaves the
# development installation untouched.
COMPOSER_VENDOR_DIR="$BUILD_DIR/vendor" composer install --no-dev --optimize-autoloader --no-interaction
php "$BASEDIR/bin/scope-mcp-adapter.php" "$BUILD_DIR/vendor" --delete-originals
# The scoped copy replaces the original packages, so the autoloader has to be
# regenerated: the manifests Composer wrote during install still map every class
# of those packages to sources this build no longer ships.
COMPOSER_VENDOR_DIR="$BUILD_DIR/vendor" composer dump-autoload --no-dev --optimize --no-interaction
rm -rf "$BUILD_DIR/vendor/php-stubs"
# Every bin directory, not just vendor/bin: packages ship their own CLI scripts
# (defuse/php-encryption/bin, ...) and none of them are used at runtime.
find "$BUILD_DIR/vendor" -type d -name bin -prune -exec rm -rf {} +

# Remove empty directories
find "$BUILD_DIR" -type d -empty -delete

php "$BASEDIR/bin/verify-vendor-manifests.php" "$BUILD_DIR/vendor"

cd "$BUILD_BASE"
ZIPF="$SLUG-$VERSION.zip"
zip -r "$ZIPF" "$SLUG" -x '*.DS_Store'
mv "$ZIPF" /tmp
rm -rf "$BUILD_BASE"
echo "$ZIPF created in /tmp"
